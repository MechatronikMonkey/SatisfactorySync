<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SatisfatorySync.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
        x:Class="SatisfatorySync.Views.SyncWindow"
        x:DataType="vm:SyncWindowViewModel"
        Icon="/Assets/satsync.ico"
        Title="SatisfatorySync"
        Width="1100"
        Height="620"
		WindowStartupLocation="CenterOwner"
		CanResize="False"
		ShowInTaskbar="False"
		SystemDecorations="None"
		Background="Transparent">
	<Window.DataContext>
		<vm:SyncWindowViewModel/>
	</Window.DataContext>

	<Design.DataContext>
		<vm:SyncWindowViewModel/>
	</Design.DataContext>

	<Canvas>
		<!-- Background Image -->
		<Image Source="/Assets/ObjectScanner.png"
               Stretch="UniformToFill"
               VerticalAlignment="Center"
               HorizontalAlignment="Center" />

		<!-- Overlay Text or other content -->
		<StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Canvas.Top="195" Canvas.Left="440" Orientation="Vertical">
			<ItemsControl ItemsSource="{Binding SyncLogList}" >
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="{Binding Text}" Foreground="#efefef" FontSize="9" FontFamily="{StaticResource PixelFont}" Margin="0,10,0,0">
								<TextBlock.Effect>
									<DropShadowEffect BlurRadius="2" Color="#6bffc1" OffsetX="2" OffsetY="2" Opacity="0.6"/>
								</TextBlock.Effect>
							</TextBlock>
							<TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="9" FontFamily="{StaticResource PixelFont}" Margin="0,10,0,0" IsVisible="{Binding StatusVisible}">
								<TextBlock.Effect>
									<DropShadowEffect BlurRadius="2" Color="#6bffc1" OffsetX="2" OffsetY="2" Opacity="0.6"/>
								</TextBlock.Effect>
							</TextBlock>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>

		<!-- Fixed Position Button -->
		<Button HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Width="160"
				Height="30"
				Canvas.Left="630"
				Canvas.Top="357"
				Background="Transparent"
				FontFamily="{StaticResource PixelFont}"
				IsVisible="{Binding ButtonVisible}">
			<TextBlock Text="YES -"
					   Foreground="White">
				<TextBlock.Effect>
					<DropShadowEffect BlurRadius="3" Color="#6bffc1" OffsetX="2" OffsetY="2" Opacity="0.6"/>
				</TextBlock.Effect>
			</TextBlock>
		</Button>

		<Button HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Width="160"
				Height="30"
				Canvas.Left="630"
				Canvas.Top="400"
				Background="Transparent"
				FontFamily="{StaticResource PixelFont}"
				IsVisible="{Binding ButtonVisible}">
			<TextBlock Text=" NO -"
					   Foreground="White">
				<TextBlock.Effect>
					<DropShadowEffect BlurRadius="3" Color="#6bffc1" OffsetX="2" OffsetY="2" Opacity="0.6"/>
				</TextBlock.Effect>
			</TextBlock>
		</Button>
	</Canvas>


</Window>
